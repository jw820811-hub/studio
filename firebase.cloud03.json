{
  "functions": [
    {
      "source": "cloud03",
      "codebase": "cloud03",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "test", ".env*", "*-debug.log", "README.md"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "target": "cloud03",
    "public": "cloud03/hosting",
    "ignore": ["**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "function": { "functionId": "cloud03Bridge", "region": "asia-east1" }
      }
    ]
  }
}
